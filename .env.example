# Geocoding services — override with local Docker instances when self-hosted
PHOTON_API=http://localhost:2322
NOMINATIM_URL=http://localhost:8080

# OSRM routing API
OSRM_API=http://localhost:80
# OSRM_API=http://router.project-osrm.org  # public fallback (rate-limited)

# Postcodes.io
POSTCODES_URL=http://localhost:8000
# POSTCODES_URL=http://localhost:80  # alternative: route via HAProxy

# OSRM data directory — car/, foot/, bike/ subdirs with pre-processed OSRM graphs
# Path is relative to docker/ (compose file location): ./osrm/data -> docker/osrm/data
OSRM_DATA=./osrm/data

# Airgap Geocoding API (FastAPI service)
API_PORT=5000
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1024

# Force all Docker images to a specific platform (e.g. for building export
# bundles targeting x86_64/Xeon servers).  Leave commented out for native
# images (default, fastest for local development).
# FORCE_PLATFORM=linux/amd64

# OSRM image and platform.
# Default uses the upstream Docker Hub image (v5.26.0, amd64-only).
# To build from source (v6.0.0), set the values below then run:
#   make osrm-build
# Or invoke the script directly:
#   ./docker/build-osrm.sh                          # arm64 → osrm-backend:arm64-local
#   ./docker/build-osrm.sh --platform linux/amd64   # amd64 → osrm-backend:amd64-local
OSRM_IMAGE=osrm/osrm-backend
OSRM_PLATFORM=linux/amd64

# OSM PBF region — controls which Geofabrik extract to download and which files
# docker-compose references. Browse https://download.geofabrik.de to find your region.
# Examples:
#   europe/great-britain     → https://download.geofabrik.de/europe/great-britain-latest.osm.pbf
#   europe/germany           → https://download.geofabrik.de/europe/germany-latest.osm.pbf
#   north-america/us/california → https://download.geofabrik.de/north-america/us/california-latest.osm.pbf
PBF_URL=https://download.geofabrik.de/europe/great-britain-latest.osm.pbf
PBF_REGION=great-britain
